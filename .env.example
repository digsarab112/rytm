# Database
# Required in production. This project is intended to use PostgreSQL on the same VPS.
# Example:
# DATABASE_URL=postgresql://rytm:CHANGE_ME@127.0.0.1:5432/rytm?schema=public
# DIRECT_URL=postgresql://rytm:CHANGE_ME@127.0.0.1:5432/rytm?schema=public
DATABASE_URL=
DIRECT_URL=

# Auth
# Server-side secrets and base URLs. Use localhost for local testing and the real domain in production.
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Admin
# Required. Only this verified Google account can access /admin.
ADMIN_EMAIL=
ADMIN_DEFAULT_NAME=Rytm Admin
ADMIN_SESSION_SECRET=
# Password admin login is disabled in production and should stay disabled for deployed stores.
# For temporary local-only troubleshooting, set ADMIN_PASSWORD_LOGIN_ENABLED=true and ADMIN_PASSWORD.
ADMIN_PASSWORD_LOGIN_ENABLED=false
ADMIN_PASSWORD=

# Google login
# Required for admin access. Add the exact callback URL in Google Cloud:
# Local: https://localhost:3000/api/auth/google/callback is not used unless you run HTTPS.
# Local HTTP testing: http://localhost:3000/api/auth/google/callback
# Production: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments
# Optional locally. In production, MONOPAY_TOKEN activates online checkout.
PAYMENT_PROVIDER=monopay
MONOPAY_TOKEN=
MONOPAY_PUBLIC_BASE_URL=
MONOPAY_WEBHOOK_URL=
MONOPAY_RESULT_URL=
MONOPAY_VALIDITY_SECONDS=86400

# Nova Poshta
# Optional global settings for future store-owned or centralized fulfillment.
# For dropshipping, supplier shipping data comes from /admin/suppliers.
# Manual TTN entry is the default launch flow and does not depend on these values.
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_CITY=
NOVA_POSHTA_SENDER_WAREHOUSE=
NOVA_POSHTA_SENDER_NAME=
NOVA_POSHTA_SENDER_PHONE=

# SMS/Viber
# Optional. Missing credentials keep customer notifications simulated/logged.
SMS_PROVIDER=
TURBOSMS_API_TOKEN=
ALPHASMS_API_TOKEN=
SMS_SENDER_NAME=
ENABLE_VIBER=false
ENABLE_SMS_FALLBACK=true

# Email
# Optional. Missing credentials keep email notifications simulated/logged.
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Rytm
FROM_EMAIL=

# Images
# Default local mode writes uploads to public/uploads on this same server.
# Supported provider values: local, url.
IMAGE_STORAGE_PROVIDER=local
IMAGE_UPLOAD_MAX_MB=5
LOCAL_UPLOAD_DIR=public/uploads
LOCAL_UPLOAD_PUBLIC_BASE_URL=/uploads

# Analytics
# Public analytics IDs are safe to expose with NEXT_PUBLIC_ and are read at build time.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Security
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
